{
  "name": "monitor",
  "description": "关键词、指定人监控转发与 Bot 集群同步（Go 源码插件）",
  "version": "1.0.0",
  "protocol_version": 2,
  "commands": [
    "monitor"
  ],
  "events": [
    "message",
    "outgoing"
  ],
  "interval_seconds": 1,
  "timeout_seconds": 60,
  "capabilities": [
    "self",
    "resolve",
    "identity",
    "messages",
    "send",
    "edit",
    "delete",
    "forward"
  ],
  "package": "."
}
